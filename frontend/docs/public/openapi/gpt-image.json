{
  "openapi": "3.0.3",
  "info": {
    "title": "Gkotta GPT Image 生图 API",
    "version": "2026-11-10",
    "description": "六款GPT Image公开模型的创建与查询。只支持async、n=1；本文件为推荐参数及有界兼容别名。字段冲突、HTTP(S)链接及枚举仍由服务端校验。创建仅POST一次；保存id后使用原Key查询，不支持Idempotency-Key去重。"
  },
  "servers": [
    {
      "url": "https://www.gkotta.bid"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "GPT Image",
      "description": "文生图与HTTP(S)参考图生图。"
    }
  ],
  "paths": {
    "/v1/images/generations": {
      "post": {
        "tags": [
          "GPT Image"
        ],
        "summary": "创建GPT Image生图任务",
        "operationId": "createGPTImage",
        "description": "Content-Type: application/json。请求体上限1MiB。HTTP202表示已受理，尚未交付图片；不支持同步或流式返回。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/GPTImage26_sunburst"
                  },
                  {
                    "$ref": "#/components/schemas/GPTImage26_flare"
                  },
                  {
                    "$ref": "#/components/schemas/GPTImage25_sunburst"
                  },
                  {
                    "$ref": "#/components/schemas/GPTImage25_flare"
                  },
                  {
                    "$ref": "#/components/schemas/GPTImage25"
                  },
                  {
                    "$ref": "#/components/schemas/GPTImage26"
                  }
                ],
                "discriminator": {
                  "propertyName": "model",
                  "mapping": {
                    "gpt-image-2.6-sunburst": "#/components/schemas/GPTImage26_sunburst",
                    "gpt-image-2.6-flare": "#/components/schemas/GPTImage26_flare",
                    "gpt-image-2.5-sunburst": "#/components/schemas/GPTImage25_sunburst",
                    "gpt-image-2.5-flare": "#/components/schemas/GPTImage25_flare",
                    "gpt-image-2.5": "#/components/schemas/GPTImage25",
                    "gpt-image-2.6": "#/components/schemas/GPTImage26"
                  }
                }
              },
              "examples": {
                "GPTImage26_sunburst_1": {
                  "summary": "gpt-image-2.6-sunburst 文生图（1K）",
                  "value": {
                    "model": "gpt-image-2.6-sunburst",
                    "prompt": "白色桌面上的蓝色陶瓷杯，柔和自然光",
                    "aspectRatio": "1:1",
                    "imageSize": "1K",
                    "quality": "auto",
                    "replyType": "async",
                    "n": 1
                  }
                },
                "GPTImage26_sunburst_2": {
                  "summary": "gpt-image-2.6-sunburst 文生图（2K）",
