        },
        "responses": {
          "202": {
            "description": "已受理，请保存id并轮询。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaImageCreated"
                }
              }
            }
          },
          "400": {
            "description": "参数、模型或余额不符，不创建任务。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaHTTPError"
                }
              }
            }
          },
          "401": {
            "description": "密钥无效。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaHTTPError"
                }
              }
            }
          },
          "403": {
            "description": "无权限。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaHTTPError"
                }
              }
            }
          },
          "404": {
            "description": "路径、模型或原密钥/任务不匹配。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaHTTPError"
                }
              }
            }
          },
          "429": {
            "description": "额度或速率限制。",
            "content": {
              "application/json": {
                "schema": {
