                    "model": "gpt-image-2.6-sunburst",
                    "prompt": "白色桌面上的蓝色陶瓷杯，柔和自然光",
                    "aspectRatio": "21:9",
                    "imageSize": "4K",
                    "quality": "high",
                    "replyType": "async",
                    "n": 1,
