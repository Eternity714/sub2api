                }
              }
            }
          }
        }
      }
    },
    "/v1/images/generations/{task_id}": {
      "get": {
        "tags": [
          "GPT Image"
        ],
        "summary": "查询生图状态与结果",
        "operationId": "getGPTImageTask",
        "description": "使用创建时的同一个API Key，每5–10秒查询。completed表示处理结束，成功需result.data有URL且error为空。",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "description": "POST返回的本地media_任务ID。",
            "schema": {
              "type": "string",
              "pattern": "^media_",
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "任务状态；生成失败也可能是HTTP200。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaImageTask"
                }
              }
            }
          },
          "410": {
            "description": "结果已过期。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaHTTPError"
                }
              }
            }
          },
          "400": {
            "description": "参数、模型或余额不符，不创建任务。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaHTTPError"
                }
              }
            }
          },
          "401": {
            "description": "密钥无效。",
