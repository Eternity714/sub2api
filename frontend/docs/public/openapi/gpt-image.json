  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "媒体API分组的Sub2API密钥。"
      }
    },
    "schemas": {
      "GPTImage26_sunburst": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "prompt"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "gpt-image-2.6-sunburst"
            ],
            "description": "公开模型 ID，区分大小写。"
          },
          "n": {
            "type": "integer",
            "default": 1,
            "minimum": 1,
            "maximum": 1,
            "description": "每次仅生成一张。"
          },
          "images": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://",
              "description": "无需登录的绝对 HTTP(S) URL；不能含用户名或密码，不支持 Base64 或 data URL。"
            },
            "description": "可选参考图，1–16 个 HTTP(S) 图片直链；没有参考图时省略，不传空数组。"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000,
            "description": "提示词，描述图像内容或对参考图的修改要求。"
          },
          "quality": {
            "type": "string",
            "enum": [
              "auto",
              "low",
              "medium",
              "high"
            ],
            "default": "auto",
            "description": "质量选项，默认auto；同一分辨率下各允许质量同价。"
          },
          "replyType": {
            "type": "string",
            "enum": [
              "async"
            ],
            "default": "async",
            "description": "仅async：返回任务ID，再轮询查询。"
          },
          "aspectRatio": {
            "type": "string",
            "enum": [
              "auto",
              "1:1",
              "16:9",
              "9:16",
              "4:3",
              "3:4",
              "3:2",
              "2:3",
              "5:4",
              "4:5",
              "21:9",
              "9:21",
              "1:2",
              "2:1",
              "1:3",
              "3:1"
            ],
            "default": "1:1",
            "description": "画面比例；auto 也按1:1构造请求。仅允许比例，不接受像素尺寸写法。"
          },
          "imageSize": {
            "type": "string",
            "enum": [
              "1K",
              "2K",
              "4K"
            ],
            "default": "1K",
            "description": "分辨率档位，默认1K，按此档位收费；4K正方形目标为2880×2880。"
          },
          "size": {
            "type": "string",
            "enum": [
              "auto",
              "1:1",
              "16:9",
              "9:16",
              "4:3",
              "3:4",
              "3:2",
              "2:3",
              "5:4",
              "4:5",
              "21:9",
              "9:21",
              "1:2",
              "2:1",
              "1:3",
              "3:1"
            ],
            "description": "兼容字段，推荐使用aspectRatio；与推荐字段同时传入时值必须一致。",
            "deprecated": true
          },
          "image_urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://",
              "description": "无需登录的绝对 HTTP(S) URL；不能含用户名或密码，不支持 Base64 或 data URL。"
            },
            "description": "兼容字段，推荐使用images；与推荐字段同时传入时值必须一致。",
            "deprecated": true
          },
          "resolution": {
            "type": "string",
            "enum": [
              "1K",
              "2K",
              "4K"
            ],
            "description": "兼容字段，推荐使用imageSize；与推荐字段同时传入时值必须一致。",
            "deprecated": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "deprecated": true,
            "properties": {
              "quality": {
                "type": "string",
                "enum": [
                  "auto",
                  "low",
                  "medium",
                  "high"
                ],
                "description": "质量选项，默认auto；同一分辨率下各允许质量同价。"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "1K",
                  "2K",
                  "4K"
                ],
                "description": "分辨率档位，默认1K，按此档位收费；4K正方形目标为2880×2880。"
              }
            },
            "description": "旧客户端的质量/分辨率兼容字段；与顶层字段同时传入必须一致。固定1K型号不能传metadata.resolution。"
          }
        },
        "description": "gpt-image-2.6-sunburst：1K/2K/4K分别0.12/0.20/0.35元/张；按分辨率收费。"
      },
      "GPTImage26_flare": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "prompt"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "gpt-image-2.6-flare"
            ],
            "description": "公开模型 ID，区分大小写。"
          },
          "n": {
            "type": "integer",
            "default": 1,
            "minimum": 1,
            "maximum": 1,
            "description": "每次仅生成一张。"
          },
          "images": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://",
              "description": "无需登录的绝对 HTTP(S) URL；不能含用户名或密码，不支持 Base64 或 data URL。"
